# Optional model configuration. Local preview does not load this file or call models.
# Only an explicit --enable-model-calls launch with call/cost limits loads it.
# OPENROUTER_API_KEY=replace-me
OPENROUTER_APP_NAME=Aria Elder Companion
# release_deepseek_v1 fixes online/safety/confirmation to DeepSeek V4.1 Flash 1017 / Together.
# Select the same offline route explicitly with --offline-model deepseek/deepseek-v4.1-flash-1017
# --offline-provider together and matching metadata/policy. Without this selection,
# memory/reflection retain the historical Sonnet route. Model env overrides do not apply.
# The current release makes zero automatic paid retries or model fallbacks.
# Unknown cost/result or persistence failure stays stopped; see the local guide.
# Default physical requests reject HTTP redirects rather than follow another address.
# OPENROUTER_ONLINE_FAST_TIMEOUT=8
# OPENROUTER_MEMORY_TIMEOUT=90
# OPENROUTER_REFLECTION_TIMEOUT=90
# Generic historical experiments only; current release fixes v7 and compact_response_v1.
# ARIA_DELIVERY_BLOCK=mode_v1
# ARIA_ONLINE_DECISION_VERSION=online_turn_decision_v3
# Real personal profiles require the secure extra and an explicit encryption key.
# ARIA_PROFILE_KEY=replace-with-a-long-random-secret
# Optional direct Alibaba ASR is separate from dialogue models and disabled by default.
# aria-asr only reads this key with --enable-asr-calls and an explicit --env-file.
# ALIYUN_DASHSCOPE_API_KEY=replace-me
# No TTS, camera, embeddings, Omni or real notification provider is included.
# Closing or idling seals it. Offline processing is manual unless the owner explicitly
# enables bounded automatic review for newly sealed sessions; all calls share the ledger.
