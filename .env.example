# Optional model configuration. Local preview does not load this file or call models.
# Only an explicit --enable-model-calls launch with call/cost limits loads it.
# OPENROUTER_API_KEY=replace-me
OPENROUTER_APP_NAME=Aria Elder Companion
# The minimal runtime fixes online=qwen/qwen3.7-flash and
# offline memory/reflection=anthropic/claude-sonnet-5. Model env overrides do not apply.
# Online and offline clients do not retry or switch models in the minimal runtime.
# OPENROUTER_ONLINE_FAST_TIMEOUT=8
# OPENROUTER_MEMORY_TIMEOUT=90
# OPENROUTER_REFLECTION_TIMEOUT=90
# Experimental only; the defaults remain mode_v1 and online_turn_decision_v1.
# ARIA_DELIVERY_BLOCK=mode_v1
# ARIA_ONLINE_DECISION_VERSION=online_turn_decision_v1
# Real personal profiles require the secure extra and an explicit encryption key.
# ARIA_PROFILE_KEY=replace-with-a-long-random-secret
# No ASR, TTS, camera, embeddings, Omni or real notification provider is included.
# Closing or idling a session only seals it. Offline processing is explicit.
